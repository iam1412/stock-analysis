# build output
dist/

# dependencies
node_modules/

# cloudflare / wrangler
.wrangler/

# OS / editor
.DS_Store
*.log

# Claude Code local settings (personal, per-machine)
.claude/settings.local.json

# lock ของ tools/lockfile.js + temp ของ writeJsonAtomic — หลุด commit ใน CI = lock ค้างถาวร (checkout ประทับ mtime ใหม่ทุกรอบ)
*.lock/
*.lock.reclaim/
*.tmp-*

# runbook เคลียร์คิว (npm run queue) — state ของรอบ + prompt ที่ประกอบให้ worker (per-machine)
.queue/

# worktree เก่าของ Claude Code (สำเนา reports/*.html) — กัน git add -A กวาดเข้า commit และกัน `npm run queue -- preflight` ฟ้อง working tree ไม่สะอาด
.claire/

# draft ของรายงาน v3 (node tools/report.js init/export → save) — ไม่ใช่ต้นฉบับ · กัน git add -A กวาด draft เข้า commit
.work/
