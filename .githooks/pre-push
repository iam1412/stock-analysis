#!/bin/sh
# pre-push hook — บล็อกการ push ถ้ารายงานใน reports/ ไม่ผ่าน quality gate
# เปิดใช้ครั้งเดียวต่อ clone:  git config core.hooksPath .githooks
# ★ ต้องมีขั้นตอนตรงกับ `npm run verify` ใน package.json เสมอ — เพิ่มชั้นใหม่ที่นั่นแล้วเติมที่นี่ด้วย
# ดู: test/check-reports.js, CLAUDE.md ข้อ 8

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo_root" || exit 0

# หา node (รองรับกรณีรันจาก GUI git ที่ PATH ไม่ครบ)
command -v node >/dev/null 2>&1 || { echo "⚠️  pre-push: ไม่พบ node — ข้ามการตรวจ (ควรตรวจเองด้วย npm test)"; exit 0; }

block() {
  echo ""
  echo "❌ push ถูกบล็อก: $1 ไม่ผ่าน (ดูปัญหาด้านบน)"
  echo "   แก้ให้ผ่าน แล้วลองใหม่  •  ข้ามชั่วคราว (ไม่แนะนำ): git push --no-verify"
  exit 1
}

# ขั้น 1-2 = unit test ของเครื่องมือ cron/canary — offline + เร็วที่สุด จึงวางไว้หน้าสุด (ล้มก่อนเสีย
# เวลา build) · เพิ่ม 8 ส.ค. 2569 หลังพบว่า syntax error ในไฟล์เทสต์เองหลุด gate ไปได้ทั้งชุด
echo "💰 pre-push 1/13: unit-test cron ราคา (update-prices-test)…"
node test/update-prices-test.js >/dev/null || block "update-prices unit gate"

echo "☠  pre-push 2/13: unit-test canary หุ้นตาย (dead-ticker-test)…"
node test/dead-ticker-test.js >/dev/null || block "dead-ticker canary unit gate"

echo "🏷  pre-push 3/13: unit-test เครื่องมือเขียน tag (tag-apply-test)…"
node test/tag-apply-test.js >/dev/null || block "tag-apply unit gate"

# ไม่ >/dev/null — ส่วน C ของ tags-test.js เป็น corpus check จริง (reports/ ↔ tags.json ↔ คลัง เช่น
# entry ค้างของหุ้นที่ลบไปแล้ว) ไม่ใช่แค่ unit test ของ tag-lib.js — ชื่อ symbol/slug ที่ผิดพิมพ์อยู่ใน
# ข้อความ ok() เอง ถ้าเงียบไว้ operator จะเห็นแค่ "ไม่ผ่าน (ดูปัญหาด้านบน)" โดยไม่มีอะไรอยู่ด้านบนให้ดู
echo "🏷  pre-push 4/13: ตรวจความสอดคล้อง tags.json ทั้งคลัง (tags-test)…"
node test/tags-test.js || block "tags corpus gate"

echo "🔍 pre-push 5/13: ตรวจคุณภาพรายงาน (check-reports)…"
node test/check-reports.js || block "report quality gate"

# ขั้น 6 = meta-test ของขั้น 5: ฉีด defect ลงรายงานจริงแล้วยืนยันว่า check ตัวที่คู่กัน "ยิงจริง" — ถ้า check
# ตัวไหนเลิกแมตช์เงียบ ๆ ขั้น 5 จะรายงาน "0 error" แล้วทั้ง gate ผ่านหมด · ไม่ >/dev/null เพราะพิมพ์ผลลง stdout
echo "🧪 pre-push 6/13: meta-test ว่า check-reports ยังจับ defect ได้ (self-test)…"
node test/self-test.js || block "checker self-test gate"

echo "📊 pre-push 7/13: แปลง Yahoo OHLC (ohlc-test)…"
node test/ohlc-test.js >/dev/null || block "ohlc transform gate"

echo "📈 pre-push 8/13: นิยาม TA engine + รัน ta-chart ใน mock DOM (ta-engine-test)…"
node test/ta-engine-test.js >/dev/null || block "TA engine gate"

echo "🔧 pre-push 9/13: build dist/ …"
node build.js >/dev/null || block "build"

echo "🧪 pre-push 10/13: unit-test build.js (เครดิตโมเดล + freshHash + injectTA)…"
node test/build-test.js >/dev/null || block "build-test"

echo "⚙️  pre-push 11/13: รัน engine ทุกรายงานใน mock DOM (engine-exec)…"
node test/engine-exec.js >/dev/null || block "engine execution gate"

echo "🧱 pre-push 12/13: โครงต้นแบบ TH/US เติมแล้วผ่าน gate (skeleton-test)…"
node test/skeleton-test.js >/dev/null || block "skeleton template gate"

echo "🌐 pre-push 13/13: ตรวจความสมบูรณ์เว็บไซต์ (check-site)…"
node test/check-site.js || block "site integrity gate"

exit 0
